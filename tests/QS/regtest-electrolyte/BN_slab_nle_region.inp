# Buckled primitive hBN slab with the nonlinear electrolyte restricted to one side of the slab.
&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT BN_slab_nle_region
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    SURFACE_DIPOLE_CORRECTION TRUE
    SURF_DIP_DIR Z
    # Locate the lowest-density grid plane in the vacuum region.
    SURF_DIP_POS -1.0
    &MGRID
      CUTOFF [Ry] 150
      NGRIDS 4
      REL_CUTOFF [Ry] 40
    &END MGRID
    &POISSON
      PERIODIC XYZ
      POISSON_SOLVER PERIODIC
    &END POISSON
    &QS
      EPS_DEFAULT 1.0E-10
    &END QS
    &SCCS ON
      ALPHA [N*m^-1] 0.0
      BETA [kbar] 0.0
      DELTA_RHO 2.0E-5
      DERIVATIVE_METHOD FFT
      EPS_SCCS 1.0E-4
      EPS_SCF 0.08
      MAX_ITER 60
      METHOD NONLINEAR_ELECTROLYTE
      MIXING 0.02
      &NONLINEAR_ELECTROLYTE
        A_K [angstrom] 0.125
        C_MOLAR 0.10
        D_ION [angstrom] -1.0
        EB_K 78.4
        EPSILON_INF 1.78
        NC_K [angstrom^-3] 0.015
        N_MOL [angstrom^-3] 0.0335
        P_MOL [angstrom] 0.50
        R_B [angstrom] 0.00
        R_CAV [angstrom] 0.00
        R_DIEL [angstrom] 1.00
        R_ION [angstrom] 2.00
        R_SOLV [angstrom] 1.40
        SIGMA_K 0.6
        SOLTEMP [K] 298.0
        TAU [eV*angstrom^-2] 8.79E-4
        ZION 1.0
        # The solvent interval (7.0--16.0 angstrom) strictly contains
        # the complete atomic z range (9.0--9.15 angstrom).
        &SOLVENT_REGION ON
          DIRECTION Z
          ION_BUFFER [angstrom] 2.0
          LOWER_BOUND [angstrom] 7.0
          SMOOTH_WIDTH [angstrom] 0.8
          UPPER_BOUND [angstrom] 16.0
        &END SOLVENT_REGION
      &END NONLINEAR_ELECTROLYTE
    &END SCCS
    &SCF
      EPS_SCF 1.0E-6
      MAX_SCF 100
      SCF_GUESS ATOMIC
      &DIAGONALIZATION ON
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING ON
        ALPHA 0.05
        METHOD DIRECT_P_MIXING
      &END MIXING
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A [angstrom] 2.5000000 0.0000000 0.0000000
      B [angstrom] 1.2500000 2.1650635 0.0000000
      C [angstrom] 0.0000000 0.0000000 18.0000000
      PERIODIC XYZ
    &END CELL
    &COORD
      B 0.0000000 0.0000000 9.0000000
      N 1.2500000 0.7216878 9.1500000
    &END COORD
    &KIND B
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q3
    &END KIND
    &KIND N
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q5
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
