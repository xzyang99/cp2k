# Buckled primitive hBN slab in a three-dimensionally periodic electrolyte cell.
# No SCCS print key is present: the final strict NLE solve must be part of the
# calculation itself and must not depend on output settings.
&GLOBAL
  PROJECT BN_slab_nle
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF [Ry] 150
      REL_CUTOFF [Ry] 40
      NGRIDS 4
    &END MGRID
    &POISSON
      PERIODIC XYZ
      POISSON_SOLVER PERIODIC
    &END POISSON
    &QS
      EPS_DEFAULT 1.0E-10
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF 40
      &DIAGONALIZATION ON
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING ON
        METHOD BROYDEN_MIXING
        ALPHA 0.20
        BETA 1.5
        NBUFFER 8
      &END MIXING
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &SCCS ON
      METHOD NONLINEAR_ELECTROLYTE
      DERIVATIVE_METHOD FFT
      EPS_SCF 0.08
      EPS_SCCS 1.0E-4
      MAX_ITER 60
      MIXING 0.02
      DELTA_RHO 2.0E-5
      ALPHA [N*m^-1] 0.0
      BETA [kbar] 0.0
      &NONLINEAR_ELECTROLYTE
        NC_K [angstrom^-3] 0.015
        SIGMA_K 0.6
        A_K [angstrom] 0.125
        TAU [eV*angstrom^-2] 8.79E-4
        R_SOLV [angstrom] 1.40
        R_DIEL [angstrom] 1.00
        R_ION [angstrom] 2.00
        R_CAV [angstrom] 0.00
        R_B [angstrom] 0.00
        C_MOLAR 0.10
        ZION 1.0
        D_ION [angstrom] -1.0
        SOLTEMP [K] 298.0
        EB_K 78.4
        EPSILON_INF 1.78
        N_MOL [angstrom^-3] 0.0335
        P_MOL [angstrom] 0.50
      &END NONLINEAR_ELECTROLYTE
    &END SCCS
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A [angstrom] 2.5000000 0.0000000 0.0000000
      B [angstrom] 1.2500000 2.1650635 0.0000000
      C [angstrom] 0.0000000 0.0000000 18.0000000
      PERIODIC XYZ
    &END CELL
    &COORD
      B 0.0000000 0.0000000 9.0000000
      N 1.2500000 0.7216878 9.1500000
    &END COORD
    &KIND B
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q3
    &END KIND
    &KIND N
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q5
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
