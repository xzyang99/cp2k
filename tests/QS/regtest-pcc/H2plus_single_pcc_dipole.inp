&GLOBAL
  PRINT_LEVEL LOW
  PROJECT H2plus_single_pcc_dipole
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
    CHARGE +1
    LSD
    POTENTIAL_FILE_NAME POTENTIAL
    SURFACE_DIPOLE_CORRECTION TRUE
    SURF_DIP_DIR Z
    SURF_DIP_POS 0.0
    &MGRID
      CUTOFF 100
      REL_CUTOFF 40
    &END MGRID
    &PLANAR_COUNTER_CHARGE ON
      MODE SINGLE
      PLANE_POSITION 12.0
      GAU_C 0.1
      PARALLEL_PLANE XY
    &END PLANAR_COUNTER_CHARGE
    &QS
      EPS_DEFAULT 1.0E-10
    &END QS
    &SCF
      EPS_SCF 1.0E-6
      MAX_SCF 50
      SCF_GUESS ATOMIC
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_SINGLE_INVERSE
      &END OT
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 8.0 9.0 15.0
      PERIODIC XYZ
    &END CELL
    &COORD
      H  3.60  4.50  7.50
      H  4.40  4.50  7.50
    &END COORD
    &KIND H
      BASIS_SET DZV-GTH-PADE
      POTENTIAL GTH-PADE-q1
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
